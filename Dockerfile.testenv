# =============================================
# Pet Chef — 测试环境镜像 (Test Environment)
# =============================================
# 用途：预装所有依赖的测试基础镜像
# 每次测试：从此镜像起容器 → 挂载源码 → 测试 → 销毁容器
#
# 构建：docker build -f Dockerfile.testenv -t petchef-test-env:b1.00 .
# =============================================

FROM node:22.22-alpine AS testenv-base

# ── 安全：创建非 root 用户 ──
RUN addgroup -S petchef && adduser -S petchef -G petchef

# ── 安装系统级测试工具 ──
RUN apk add --no-cache curl wget

# =============================================
# Stage 1: 预装 Backend 依赖
# =============================================
FROM testenv-base AS backend-deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json* ./
RUN npm install --ignore-scripts \
    && npm cache clean --force

# =============================================
# Stage 2: 预装 Frontend 依赖
# =============================================
FROM testenv-base AS frontend-deps
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --ignore-scripts \
    && npm cache clean --force

# =============================================
# Stage 3: 合并为最终测试镜像
# =============================================
FROM testenv-base AS testenv

WORKDIR /app

# 从各 stage 复制预装的 node_modules
COPY --from=backend-deps --chown=petchef:petchef /app/backend/node_modules ./backend/node_modules
COPY --from=frontend-deps --chown=petchef:petchef /app/frontend/node_modules ./frontend/node_modules

# 复制 package.json（运行时可能需要 scripts）
COPY --from=backend-deps --chown=petchef:petchef /app/backend/package.json ./backend/package.json
COPY --from=frontend-deps --chown=petchef:petchef /app/frontend/package.json ./frontend/package.json

# 安全加固
RUN chown -R petchef:petchef /app

USER petchef

# 环境变量默认值
ENV NODE_ENV=development
ENV PORT=3001

EXPOSE 3001 5174

# 默认启动一个保活 shell（实际启动命令由 docker-compose 覆盖）
CMD ["sh", "-c", "echo 'Pet Chef Test Environment Ready' && sleep infinity"]
