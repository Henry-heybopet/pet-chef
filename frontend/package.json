{
  "name": "frontend",
  "private": true,
  "version": "B1.00",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:factory": "vite build --mode factory-debug",
    "app:build": "npm run build && npx cap sync",
    "app:factory": "npm run build:factory && npx cap sync",
    "app:factory:ios": "npm run build:factory && npx cap sync ios",
    "app:factory:android": "npm run build:factory && npx cap sync android",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@vitejs/plugin-react": "^4.0.3",
    "vite": "^4.4.5"
  }
}
