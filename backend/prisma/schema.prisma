datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum IdentityProvider {
  phone
  email
  wechat
  apple
  google
}

enum PetSpecies {
  dog
  cat
}

enum PetSex {
  male
  female
  unknown
}

enum ActivityLevel {
  low
  medium
  high
}

enum LifeStage {
  puppy
  adult
  senior
}

enum ProductType {
  pet_chef
}

enum DeviceStatus {
  active
  offline
  unbound
  disabled
}

enum RecipeStatus {
  draft
  active
  archived
}

enum RecipeSourceType {
  manual
  nutritionist
  ai
  imported
}

enum CookingOperationType {
  start_cooking
  pause
  resume
  stop
  simulate
}

enum CookingOperationStatus {
  created
  running
  completed
  failed
  cancelled
}

model User {
  id            String     @id
  display_name  String
  avatar_url    String?
  primary_phone String?
  primary_email String?
  country_code  String
  region        String
  language      String     @default("zh")
  timezone      String
  status        UserStatus @default(active)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?

  identities         UserIdentity[]
  owned_households   Household[]
  memberships        HouseholdMember[]
  tuya_mappings      TuyaUserMapping[]
  pets               Pet[]
  devices            Device[]
  cooking_operations CookingOperation[]
  feeding_records    FeedingRecord[]
  health_records     HealthRecord[]
  medical_records    MedicalRecord[]
  orders             Order[]
  payments           Payment[]
  analytics_events   AnalyticsEvent[]

  @@index([primary_phone])
  @@index([primary_email])
  @@index([status])
  @@index([created_at])
  @@map("users")
}

model UserIdentity {
  id                 String           @id
  user_id            String
  provider           IdentityProvider
  provider_user_id   String
  login_hash         String
  phone_country_code String?
  is_primary         Boolean
  verified_at        DateTime?
  created_at         DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([provider, login_hash])
  @@index([user_id])
  @@map("user_identities")
}

model Household {
  id            String   @id
  name          String
  owner_user_id String
  region        String
  address_id    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  owner   User              @relation(fields: [owner_user_id], references: [id])
  members HouseholdMember[]
  pets    Pet[]
  devices Device[]
  cooking_operations CookingOperation[]
  feeding_records    FeedingRecord[]
  health_records     HealthRecord[]
  medical_records    MedicalRecord[]
  orders             Order[]

  @@index([owner_user_id])
  @@index([region])
  @@map("households")
}

model HouseholdMember {
  id           String   @id
  household_id String
  user_id      String
  role         String   @default("member")
  status       String   @default("active")
  invited_by   String?
  joined_at    DateTime @default(now())

  household Household @relation(fields: [household_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([household_id])
  @@index([user_id])
  @@map("household_members")
}

model TuyaUserMapping {
  id                 String   @id
  user_id            String
  tuya_uid           String
  tuya_country_code  String?
  tuya_region        String?
  tuya_home_ids      String[] @default([])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("tuya_user_mappings")
}

model Pet {
  id                   String        @id
  household_id         String
  owner_user_id        String
  name                 String
  species              PetSpecies
  breed                String?
  sex                  PetSex?
  neutered             Boolean
  birth_date           DateTime?
  age_months           Int?
  current_weight_kg    Float?
  target_weight_kg     Float?
  body_condition_score String?
  activity_level       ActivityLevel @default(medium)
  life_stage           LifeStage     @default(adult)
  allergens            Json          @default("[]")
  food_restrictions    Json          @default("[]")
  health_tags          Json          @default("[]")
  doctor_notes         String?
  user_notes           String?
  avatar_url           String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  deleted_at           DateTime?

  household          Household          @relation(fields: [household_id], references: [id])
  owner              User               @relation(fields: [owner_user_id], references: [id])
  device_bindings    DevicePetBinding[]
  cooking_operations CookingOperation[]
  feeding_records    FeedingRecord[]
  health_records     HealthRecord[]
  medical_records    MedicalRecord[]
  orders             Order[]

  @@index([household_id])
  @@index([owner_user_id])
  @@index([species])
  @@index([life_stage])
  @@map("pets")
}

model Device {
  id               String       @id
  household_id     String
  owner_user_id    String
  tuya_device_id   String       @unique
  tuya_home_id     String?
  tuya_pid         String?
  product_type     ProductType  @default(pet_chef)
  device_name      String
  status           DeviceStatus @default(active)
  firmware_version String?
  last_online_at   DateTime?
  bound_at         DateTime     @default(now())
  unbound_at       DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  household          Household          @relation(fields: [household_id], references: [id])
  owner              User               @relation(fields: [owner_user_id], references: [id])
  pet_bindings       DevicePetBinding[]
  cooking_operations CookingOperation[]

  @@index([household_id])
  @@index([status])
  @@map("devices")
}

model DevicePetBinding {
  id         String   @id
  device_id  String
  pet_id     String
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [pet_id], references: [id], onDelete: Cascade)

  @@unique([device_id, pet_id])
  @@map("device_pet_bindings")
}

model Recipe {
  id                 String       @id
  name               String
  species            PetSpecies
  category           String
  life_stage         String?
  health_tags        Json         @default("[]")
  ingredients        Json         @default("[]")
  nutrition_snapshot Json?
  cooking_profile    Json
  source_id          String?
  status             RecipeStatus @default(active)
  version            Int          @default(1)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  source             RecipeSource?      @relation(fields: [source_id], references: [id])
  cooking_operations CookingOperation[]
  feeding_records    FeedingRecord[]

  @@index([species])
  @@index([category])
  @@index([status])
  @@index([source_id])
  @@map("recipes")
}

model RecipeSource {
  id            String           @id
  source_type   RecipeSourceType @default(manual)
  title         String
  author        String?
  reference_url String?
  license       String?
  reviewed_by   String?
  reviewed_at   DateTime?
  notes         String?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  recipes Recipe[]

  @@index([source_type])
  @@index([reviewed_by])
  @@map("recipe_sources")
}

model IngredientLibrary {
  id                String   @id
  name              String
  category          String
  safety_level      String   @default("safe")
  safety_note       String?
  water_pct         Float?
  protein_pct       Float?
  fat_pct           Float?
  carb_pct          Float?
  fiber_pct         Float?
  calories_per_100g Float?
  benefits          String?
  created_at        DateTime @default(now())

  @@index([category])
  @@index([safety_level])
  @@map("ingredient_library")
}

model CookingOperation {
  id                      String                 @id
  user_id                 String
  household_id            String
  pet_id                  String?
  device_id               String?
  recipe_id               String?
  operation_type          CookingOperationType
  status                  CookingOperationStatus
  total_weight_g          Float?
  ingredients_snapshot    Json?
  cooking_params_snapshot Json?
  tuya_command_snapshot   Json?
  result                  String?
  error_code              String?
  started_at              DateTime?
  completed_at            DateTime?
  created_at              DateTime               @default(now())

  user      User      @relation(fields: [user_id], references: [id])
  household Household @relation(fields: [household_id], references: [id])
  pet       Pet?      @relation(fields: [pet_id], references: [id])
  device    Device?   @relation(fields: [device_id], references: [id])
  recipe    Recipe?   @relation(fields: [recipe_id], references: [id])

  feeding_records FeedingRecord[]

  @@index([household_id])
  @@index([pet_id])
  @@index([device_id])
  @@index([recipe_id])
  @@index([status])
  @@index([created_at])
  @@map("cooking_operations")
}

model FeedingRecord {
  id                   String    @id
  user_id              String
  household_id         String
  pet_id               String
  recipe_id            String?
  cooking_operation_id String?
  fed_at               DateTime
  amount_g             Float?
  meal_type            String?
  appetite_score       Int?
  notes                String?
  created_at           DateTime  @default(now())

  user              User              @relation(fields: [user_id], references: [id])
  household         Household         @relation(fields: [household_id], references: [id])
  pet               Pet               @relation(fields: [pet_id], references: [id])
  recipe            Recipe?           @relation(fields: [recipe_id], references: [id])
  cooking_operation CookingOperation? @relation(fields: [cooking_operation_id], references: [id])

  @@index([household_id])
  @@index([pet_id])
  @@index([fed_at])
  @@map("feeding_records")
}

model HealthRecord {
  id              String   @id
  user_id         String
  household_id    String
  pet_id          String
  recorded_at     DateTime
  weight_kg       Float?
  stool_score     Int?
  appetite_score  Int?
  skin_coat_score Int?
  activity_score  Int?
  symptoms        Json     @default("[]")
  notes           String?
  created_at      DateTime @default(now())

  user      User      @relation(fields: [user_id], references: [id])
  household Household @relation(fields: [household_id], references: [id])
  pet       Pet       @relation(fields: [pet_id], references: [id])

  @@index([household_id])
  @@index([pet_id])
  @@index([recorded_at])
  @@map("health_records")
}

model MedicalRecord {
  id                String   @id
  user_id           String
  household_id      String
  pet_id            String
  record_type       String
  occurred_at       DateTime
  clinic_name       String?
  vet_name          String?
  summary           String
  attachments       Json     @default("[]")
  next_follow_up_at DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user      User      @relation(fields: [user_id], references: [id])
  household Household @relation(fields: [household_id], references: [id])
  pet       Pet       @relation(fields: [pet_id], references: [id])

  @@index([household_id])
  @@index([pet_id])
  @@index([record_type])
  @@index([occurred_at])
  @@map("medical_records")
}

model Product {
  id             String   @id
  name           String
  category       String
  target_tags    Json     @default("[]")
  description    String?
  default_sku_id String?
  status         String   @default("active")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  skus        Sku[]
  order_items OrderItem[]

  @@index([category])
  @@index([status])
  @@map("products")
}

model Sku {
  id           String   @id
  product_id   String
  sku_code     String
  name         String
  spec         Json?
  price_cents  Int
  currency     String   @default("CNY")
  stock_status String   @default("in_stock")
  status       String   @default("active")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@index([sku_code])
  @@index([status])
  @@map("skus")
}

model Order {
  id               String   @id
  user_id          String
  household_id     String
  pet_id           String?
  status           String   @default("created")
  total_cents      Int
  currency         String   @default("CNY")
  payment_status   String   @default("pending")
  shipping_address Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  user      User      @relation(fields: [user_id], references: [id])
  household Household @relation(fields: [household_id], references: [id])
  pet       Pet?      @relation(fields: [pet_id], references: [id])

  order_items OrderItem[]
  payments    Payment[]

  @@index([user_id])
  @@index([household_id])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id               String   @id
  order_id         String
  product_id       String
  product_name     String?
  quantity         Int      @default(1)
  unit_price_cents Int
  created_at       DateTime @default(now())

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Payment {
  id                  String   @id
  order_id            String
  user_id             String
  provider            String
  provider_payment_id String?
  amount_cents        Int
  currency            String
  status              String   @default("pending")
  paid_at             DateTime?
  raw_payload         Json?
  idempotency_key     String?  @unique
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  order Order @relation(fields: [order_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@index([order_id])
  @@index([user_id])
  @@index([provider_payment_id])
  @@index([status])
  @@map("payments")
}

model AdminUser {
  id            String    @id
  display_name  String
  email         String    @unique
  role          String
  status        String    @default("active")
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([role])
  @@index([status])
  @@map("admin_users")
}

model AnalyticsEvent {
  id           String   @id
  user_id      String?
  household_id String?
  session_id   String?
  event_name   String
  event_source String
  properties   Json?
  occurred_at  DateTime
  created_at   DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([event_name])
  @@index([occurred_at])
  @@map("analytics_events")
}
