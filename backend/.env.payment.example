# Never commit real merchant keys or private-key files.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
# Keep true for local module tests. Set to false only after merchant credentials
# and callback domain are ready for real WeChat Pay API requests.
WECHAT_PAY_USE_MOCK=true
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
WECHAT_PAY_HTTP_TIMEOUT_MS=10000

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=https://api.example.com/api/payments/alipay/notify

# Local development only. Keep disabled in every deployed environment.
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SECRET=
