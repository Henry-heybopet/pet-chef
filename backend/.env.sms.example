# Copy these names into backend/.env for local validation.
# Never commit real AccessKey values or SMS_VERIFICATION_SECRET.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Generate at least 32 random bytes and keep this stable across restarts.
SMS_VERIFICATION_SECRET=

# Session and agreement versions
JWT_EXPIRES_IN=30d
TERMS_VERSION=2026-07-31
PRIVACY_VERSION=2026-07-31
