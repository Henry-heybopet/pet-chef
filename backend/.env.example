# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Database Configuration (PostgreSQL / Supabase / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petchef?schema=public
# Regional database overrides (optional)
CN_DATABASE_URL=
US_DATABASE_URL=
EU_DATABASE_URL=

# DeepSeek AI API Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Gemini AI API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Tuya IoT Cloud API Configuration
TUYA_ACCESS_ID=
TUYA_SECRET=
TUYA_DEVICE_ID=
TUYA_BASE_URL=https://openapi.tuyacn.com

# Object Storage Configuration
OSS_BASE_URL=
